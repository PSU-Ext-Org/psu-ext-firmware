# PSU-EXT production defaults for ESP-IDF 6.1.
CONFIG_IDF_TARGET="esp32s3"

# Board flash: preserve DIO at 80 MHz and the large single-app partition.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_RTC_CLK_SRC_EXT_CRYS=y

# Board PSRAM: 16 MB octal device, detected at boot. ECC reserves 1/16.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ECC_ENABLE=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=y
# Preserve the existing timeout instead of the PSRAM-dependent 800 ms default.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300

# Native USB CDC SCPI transport and Wi-Fi station support.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512
CONFIG_ESP_PHY_ENABLE_USB=y
CONFIG_ESP_WIFI_ENABLED=y

# Preserve the existing calibration policy.
CONFIG_PSUEXT_CAL_REQUIRE_MIN_POINTS_PER_PGA=n

# Keep normal operational logs; compile out debug and verbose logging.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y

# External I2C modules are opt-in.
CONFIG_PSUEXT_I2C_1_SSD1306=n
